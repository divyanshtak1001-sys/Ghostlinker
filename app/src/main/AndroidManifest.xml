<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ─── Wi-Fi Direct ─────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- INTERNET is required for socket operations within the Wi-Fi Direct group -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ─── Nearby Wi-Fi (Android 13+) ─────────────────────────────────── -->
    <!--
        NEARBY_WIFI_DEVICES replaces ACCESS_FINE_LOCATION for Wi-Fi Direct discovery
        on API 33+. Both are declared for backward compatibility.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- ─── Location — required for Wi-Fi Direct discovery on API < 33 ─── -->
    <!--
        GhostLink requests location permission only because Wi-Fi Direct peer
        discovery requires it on Android 9–12. It is not used to track the
        user's physical location or build location history.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ─── Bluetooth (API 31+) ─────────────────────────────────────────── -->
    <!--
        Bluetooth Classic RFCOMM connections plus BLE scanning and advertising.
        BLUETOOTH_CONNECT is required for RFCOMM and device names; SCAN is used
        for Classic/BLE discovery and ADVERTISE for BLE / temporary visibility.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />

    <!-- Legacy Bluetooth (API < 31) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- ─── Camera (QR scanning) ─────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ─── Foreground service (optional background session) ────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ─── Vibrate (haptic feedback on connect/receive) ────────────────── -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ─── Wi-Fi Direct hardware feature ────────────────────────────────── -->
    <!--
        Declared as not required so the app installs on devices without
        Wi-Fi Direct; the UI reports Wi-Fi Direct as unavailable instead of
        crashing. android.hardware.wifi.direct is the correct feature name for
        WifiP2pManager availability.
    -->
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <!-- ─── Hardware feature declarations (not required — graceful degradation) -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GhostLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <!-- Primary launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: ghostlink://invite/CODE or ghostlink://pair?code=CODE -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ghostlink" android:host="invite" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ghostlink" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
            GhostLink foreground service for optional background-session mode.
            Type: connectedDevice — appropriate for an ongoing peer-to-peer
            session where the device maintains a network connection.
            This service is only started when the user explicitly enables
            "Keep Active Session Connected in Background" in Settings.
        -->
        <service
            android:name=".service.GhostLinkService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
